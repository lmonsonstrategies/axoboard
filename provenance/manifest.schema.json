{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/provenance-manifest-v1.json",
  "title": "AxoBoard one-way source extraction and review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "allowedSources", "entries", "exceptions"],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "version": { "const": 1 },
    "allowedSources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRepo", "sourceSha", "sourcePath", "destinationPaths", "extractionMethod", "rationale", "genericContract", "reviewedBy", "reviewedAt"],
        "properties": {
          "sourceRepo": { "type": "string", "minLength": 8 },
          "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sourcePath": { "type": "string", "minLength": 1 },
          "destinationPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "extractionMethod": { "enum": ["concept", "port", "copy"] },
          "rationale": { "type": "string", "minLength": 12 },
          "genericContract": { "type": "string", "minLength": 12 },
          "reviewedBy": { "type": "string", "minLength": 2 },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "rules", "rationale", "reviewedBy", "reviewedAt"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["company-identity", "company-domain", "legacy-workspace-path", "tenant-provider-id", "credential-material", "brand-asset", "business-assumption"]
            }
          },
          "rationale": { "type": "string", "minLength": 12 },
          "reviewedBy": { "type": "string", "minLength": 2 },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
