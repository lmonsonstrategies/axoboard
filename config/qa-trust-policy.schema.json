{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-trust-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "issuedBy", "issuedAt", "expiresAt", "reviewers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "axoboard-owner-controlled-qa-trust-policy" },
    "issuedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
    "issuedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "expiresAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "keyId", "algorithm", "publicKeyPem", "roles", "active"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
          "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,95}$" },
          "algorithm": { "const": "Ed25519" },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\n?$" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["authenticated-evidence", "expert-review"] }
          },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
