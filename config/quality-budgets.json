{
  "$schema": "./quality-budgets.schema.json",
  "schemaVersion": 1,
  "product": "AxoBoard",
  "mode": "public-non-mutating",
  "browserEngines": ["chromium", "firefox", "webkit"],
  "failOn": ["P0", "P1"],
  "allowedBaseUrls": [
    "https://axoboard.io",
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "routes": [
    { "id": "home", "path": "/", "surface": "landing", "state": "default", "themes": ["light"], "viewports": ["phone-320", "phone-375", "phone-390", "phone-430", "tablet-portrait", "tablet-landscape", "desktop-1280", "desktop-1440", "wide-1728"], "checkpoint": true, "baselineRequired": true },
    { "id": "features", "path": "/features", "surface": "landing", "state": "features", "themes": ["light"], "viewports": ["phone-375", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": true },
    { "id": "integrations", "path": "/integrations", "surface": "landing", "state": "integrations", "themes": ["light"], "viewports": ["phone-375", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": true },
    { "id": "pricing", "path": "/pricing", "surface": "landing", "state": "pricing", "themes": ["light"], "viewports": ["phone-375", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": true },
    { "id": "faq", "path": "/faq", "surface": "landing", "state": "faq", "themes": ["light"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": false, "baselineRequired": false },
    { "id": "login", "path": "/login", "surface": "auth", "state": "login", "themes": ["light"], "viewports": ["phone-320", "phone-390", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": true },
    { "id": "signup", "path": "/signup", "surface": "auth", "state": "signup-step-1", "themes": ["light"], "viewports": ["phone-320", "phone-390", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": true },
    { "id": "app-auth-guard", "path": "/app", "expectedPath": "/login", "surface": "app", "state": "unauthenticated-redirect", "themes": ["light"], "viewports": ["phone-390", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "tv-pairing", "path": "/tv", "surface": "tv", "state": "pairing-empty", "themes": ["dark"], "viewports": ["tablet-landscape", "desktop-1440", "wide-1728", "tv-1920"], "checkpoint": true, "baselineRequired": true },
    { "id": "privacy", "path": "/privacy", "surface": "legal", "state": "default", "themes": ["light"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": false, "baselineRequired": false },
    { "id": "terms", "path": "/terms", "surface": "legal", "state": "default", "themes": ["light"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": false, "baselineRequired": false }
  ],
  "fixtureRoutes": [
    { "id": "fixture-landing", "path": "/fixtures/good?state=landing", "surface": "landing", "state": "default", "themes": ["light", "dark"], "viewports": ["phone-375", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "fixture-auth", "path": "/fixtures/good?state=auth", "surface": "auth", "state": "login-error", "themes": ["light", "dark"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "fixture-app-empty", "path": "/fixtures/good?state=app-empty", "surface": "app", "state": "empty", "themes": ["light", "dark"], "viewports": ["phone-375", "tablet-portrait", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "fixture-app-loading", "path": "/fixtures/good?state=app-loading", "surface": "app", "state": "loading", "themes": ["light", "dark"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "fixture-app-error", "path": "/fixtures/good?state=app-error", "surface": "app", "state": "error", "themes": ["light", "dark"], "viewports": ["phone-375", "desktop-1440"], "checkpoint": true, "baselineRequired": false },
    { "id": "fixture-tv", "path": "/fixtures/good?state=tv", "surface": "tv", "state": "live", "themes": ["dark"], "viewports": ["tablet-landscape", "tv-1920"], "checkpoint": true, "baselineRequired": false }
  ],
  "badFixtureRoutes": [
    { "id": "fixture-deliberate-bad", "path": "/fixtures/bad", "surface": "fixture", "state": "deliberate-hard-failures", "themes": ["light"], "viewports": ["phone-375"], "checkpoint": true, "baselineRequired": false }
  ],
  "humanOnlyScenarios": [
    {
      "id": "authenticated-app-critical-states",
      "type": "authenticated-app",
      "surface": "app",
      "states": ["default", "empty", "loading", "error"],
      "viewports": ["phone-375", "tablet-portrait", "desktop-1440"],
      "themes": ["light"],
      "browserEngines": ["chromium", "firefox", "webkit"],
      "requiredMatrix": [
        { "state": "default", "role": "owner", "device": "phone", "theme": "light", "viewport": "phone-375" },
        { "state": "default", "role": "viewer", "device": "desktop", "theme": "light", "viewport": "desktop-1440" },
        { "state": "empty", "role": "owner", "device": "tablet", "theme": "light", "viewport": "tablet-portrait" },
        { "state": "empty", "role": "viewer", "device": "phone", "theme": "light", "viewport": "phone-375" },
        { "state": "loading", "role": "owner", "device": "desktop", "theme": "light", "viewport": "desktop-1440" },
        { "state": "loading", "role": "viewer", "device": "phone", "theme": "light", "viewport": "phone-375" },
        { "state": "error", "role": "owner", "device": "desktop", "theme": "light", "viewport": "desktop-1440" },
        { "state": "error", "role": "viewer", "device": "phone", "theme": "light", "viewport": "phone-375" }
      ],
      "blocker": "Requires a disposable non-production tenant and authenticated browser state; customer and production credentials are prohibited."
    },
    {
      "id": "paired-tv-live-state",
      "type": "paired-tv",
      "surface": "tv",
      "states": ["live", "offline", "stale", "celebration"],
      "viewports": ["tablet-landscape", "tv-1920"],
      "themes": ["dark"],
      "browserEngines": ["chromium", "firefox", "webkit"],
      "requiredMatrix": [
        { "state": "live", "role": "display-device", "device": "landscape-tablet", "theme": "dark", "viewport": "tablet-landscape" },
        { "state": "live", "role": "display-device", "device": "tv", "theme": "dark", "viewport": "tv-1920" },
        { "state": "offline", "role": "display-device", "device": "landscape-tablet", "theme": "dark", "viewport": "tablet-landscape" },
        { "state": "offline", "role": "display-device", "device": "tv", "theme": "dark", "viewport": "tv-1920" },
        { "state": "stale", "role": "display-device", "device": "landscape-tablet", "theme": "dark", "viewport": "tablet-landscape" },
        { "state": "stale", "role": "display-device", "device": "tv", "theme": "dark", "viewport": "tv-1920" },
        { "state": "celebration", "role": "display-device", "device": "landscape-tablet", "theme": "dark", "viewport": "tablet-landscape" },
        { "state": "celebration", "role": "display-device", "device": "tv", "theme": "dark", "viewport": "tv-1920" }
      ],
      "blocker": "Requires a disposable paired display token backed by synthetic data; production display tokens are prohibited."
    }
  ],
  "optionalRoutes": [
    {
      "id": "public-tv-player",
      "env": "AXOBOARD_TV_PUBLIC_PATH",
      "pattern": "^/display/[A-Za-z0-9_-]{8,128}$",
      "checkpoint": true,
      "surface": "white-label",
      "state": "live",
      "themes": ["dark"],
      "viewports": ["tablet-landscape", "desktop-1440", "tv-1920"],
      "baselineRequired": true
    }
  ],
  "viewports": [
    { "id": "phone-320", "width": 320, "height": 568, "dpr": 2 },
    { "id": "phone-375", "width": 375, "height": 812, "dpr": 3 },
    { "id": "phone-390", "width": 390, "height": 844, "dpr": 3 },
    { "id": "phone-430", "width": 430, "height": 932, "dpr": 3 },
    { "id": "tablet-portrait", "width": 768, "height": 1024, "dpr": 2 },
    { "id": "tablet-landscape", "width": 1024, "height": 768, "dpr": 2 },
    { "id": "desktop-1280", "width": 1280, "height": 800, "dpr": 1 },
    { "id": "desktop-1440", "width": 1440, "height": 900, "dpr": 2 },
    { "id": "wide-1728", "width": 1728, "height": 1117, "dpr": 2 },
    { "id": "tv-1920", "width": 1920, "height": 1080, "dpr": 1 }
  ],
  "canonicalScreenshotViewports": ["phone-375", "tablet-portrait", "desktop-1440", "tv-1920"],
  "evidencePolicy": {
    "maximumAgeHours": 72,
    "maximumClockSkewMinutes": 5
  },
  "budgets": {
    "horizontalOverflowPx": 1,
    "minimumTouchTargetPx": 44,
    "minimumBodyFontPx": 16,
    "minimumTvBodyFontPx": 24,
    "maximumTextLineLengthCh": 75,
    "maximumMotionMsReduced": 100,
    "lcpMs": 2500,
    "cls": 0.1,
    "inpMs": 200,
    "navigationMs": 4000,
    "consoleErrors": 0,
    "failedSameOriginResources": 0,
    "brokenSameOriginLinks": 0,
    "imageDensityRatio": 0.95,
    "tvSafeAreaPercent": 5,
    "maximumScreenshotDiffRatio": 0.001,
    "maximumPositiveTabIndex": 0,
    "maximumLayoutShiftBeforeFonts": 1
  },
  "sensitivePatterns": [
    "murphy\\s*door",
    "murphydoor",
    "workspace-murphy",
    "n8n-murphy-sales",
    "BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY",
    "AIza[0-9A-Za-z_-]{30,}"
  ],
  "qualityPolicy": {
    "p0P1BlockRelease": true,
    "maximumP2ForPremiumAcceptance": 0,
    "expertReviewRequired": true,
    "visualBaselineUpdatesRequireIndependentApproval": true,
    "qualitativeDimensions": ["hierarchy", "typography", "spacing-rhythm", "alignment-grid", "density", "surface-material", "icon-consistency", "microcopy", "interaction-states", "motion-intent", "perceived-polish", "brand-distinctiveness"],
    "minimumQualitativeScore": 4,
    "releaseBlockerRules": ["runtime.*", "navigation.route-status", "layout.horizontal-overflow", "interaction.touch-target", "accessibility.*", "axe.*", "motion.reduced-motion-parity", "visual.baseline-*", "visual.screenshot-instability", "privacy.*"]
  }
}
