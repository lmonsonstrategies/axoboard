{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-authenticated-artifact-manifest-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "scenarioId", "scenarioType", "runId", "captureActor", "candidateSha", "targetOrigin", "syntheticTenant", "captureStartedAt", "captureCompletedAt", "playwrightVersion", "matrix", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "axoboard-human-qa-scenario-artifact-manifest" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scenarioType": { "enum": ["authenticated-app", "paired-tv"] },
    "runId": { "type": "string", "pattern": "^qa-[a-z0-9][a-z0-9-]{7,63}$" },
    "captureActor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "targetOrigin": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "syntheticTenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "pattern": "^synthetic-[a-z0-9][a-z0-9_-]{5,63}$" },
        "workspaceId": { "type": "string", "pattern": "^synthetic-[a-z0-9][a-z0-9_-]{5,63}$" }
      }
    },
    "captureStartedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "captureCompletedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "playwrightVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "role", "device", "theme", "viewport", "browserEngine", "browserVersion", "artifactPaths"],
        "properties": {
          "state": { "type": "string", "minLength": 1, "maxLength": 80 },
          "role": { "type": "string", "minLength": 1, "maxLength": 80 },
          "device": { "type": "string", "minLength": 1, "maxLength": 80 },
          "theme": { "enum": ["light", "dark"] },
          "viewport": { "type": "string", "minLength": 1, "maxLength": 80 },
          "browserEngine": { "enum": ["chromium", "firefox", "webkit"] },
          "browserVersion": { "type": "string", "minLength": 2, "maxLength": 120 },
          "artifactPaths": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256", "mediaType"],
        "properties": {
          "kind": { "enum": ["screenshot", "playwright-trace"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 255 },
          "bytes": { "type": "integer", "minimum": 8 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "enum": ["image/png", "application/zip"] }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "screenshot" } } }, "then": { "properties": { "path": { "pattern": "\\.png$" }, "mediaType": { "const": "image/png" } } } },
          { "if": { "properties": { "kind": { "const": "playwright-trace" } } }, "then": { "properties": { "path": { "pattern": "\\.zip$" }, "mediaType": { "const": "application/zip" } } } }
        ]
      }
    }
  }
}
