{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-authenticated-artifact-manifest-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "scenarioId", "scenarioType", "runId", "candidateSha", "targetOrigin", "syntheticTenant", "captureStartedAt", "captureCompletedAt", "matrix", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "axoboard-human-qa-scenario-artifact-manifest" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scenarioType": { "enum": ["authenticated-app", "paired-tv"] },
    "runId": { "type": "string", "pattern": "^qa-[a-z0-9][a-z0-9-]{7,63}$" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "targetOrigin": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "syntheticTenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "workspaceId"],
      "properties": {
        "tenantId": { "type": "string", "pattern": "^synthetic-[a-z0-9][a-z0-9_-]{5,63}$" },
        "workspaceId": { "type": "string", "pattern": "^synthetic-[a-z0-9][a-z0-9_-]{5,63}$" }
      }
    },
    "captureStartedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "captureCompletedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "role", "device", "theme", "viewport", "browserEngine", "artifactPaths"],
        "properties": {
          "state": { "type": "string", "minLength": 1, "maxLength": 80 },
          "role": { "type": "string", "minLength": 1, "maxLength": 80 },
          "device": { "type": "string", "minLength": 1, "maxLength": 80 },
          "theme": { "enum": ["light", "dark"] },
          "viewport": { "type": "string", "minLength": 1, "maxLength": 80 },
          "browserEngine": { "enum": ["chromium", "firefox", "webkit", "safari", "chrome"] },
          "artifactPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 255 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        }
      }
    }
  }
}
