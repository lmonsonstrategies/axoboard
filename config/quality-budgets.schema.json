{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-quality-budgets-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "mode", "browserEngines", "failOn", "allowedBaseUrls", "routes", "fixtureRoutes", "badFixtureRoutes", "humanOnlyScenarios", "viewports", "evidencePolicy", "budgets", "qualityPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "AxoBoard" },
    "mode": { "const": "public-non-mutating" },
    "browserEngines": {
      "type": "array",
      "const": ["chromium", "firefox", "webkit"]
    },
    "failOn": {
      "type": "array",
      "items": { "enum": ["P0", "P1", "P2", "P3"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowedBaseUrls": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "fixtureRoutes": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/route" }
    },
    "badFixtureRoutes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "humanOnlyScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "surface", "states", "viewports", "themes", "requiredMatrix", "blocker"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["authenticated-app", "paired-tv"] },
          "surface": { "enum": ["app", "tv"] },
          "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "viewports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
          "requiredMatrix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "role", "device", "theme", "viewport"],
              "properties": {
                "state": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "device": { "type": "string", "minLength": 1 },
                "theme": { "enum": ["light", "dark"] },
                "viewport": { "type": "string", "minLength": 1 }
              }
            }
          },
          "blocker": { "type": "string", "minLength": 20 }
        }
      }
    },
    "optionalRoutes": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/route" },
          {
            "type": "object",
            "required": ["env", "pattern"],
            "properties": {
              "env": { "type": "string", "minLength": 1 },
              "pattern": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width", "height", "dpr"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 320 },
          "height": { "type": "integer", "minimum": 568 },
          "dpr": { "type": "number", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "canonicalScreenshotViewports": { "type": "array", "items": { "type": "string" } },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumAgeHours", "maximumClockSkewMinutes"],
      "properties": {
        "maximumAgeHours": { "type": "number", "minimum": 1, "maximum": 168 },
        "maximumClockSkewMinutes": { "type": "number", "minimum": 0, "maximum": 15 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 },
      "required": ["horizontalOverflowPx", "minimumTouchTargetPx", "lcpMs", "cls", "navigationMs"]
    },
    "sensitivePatterns": { "type": "array", "items": { "type": "string" } },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0P1BlockRelease", "maximumP2ForPremiumAcceptance", "expertReviewRequired", "visualBaselineUpdatesRequireIndependentApproval", "qualitativeDimensions", "minimumQualitativeScore", "releaseBlockerRules"],
      "properties": {
        "p0P1BlockRelease": { "const": true },
        "maximumP2ForPremiumAcceptance": { "type": "integer", "minimum": 0 },
        "expertReviewRequired": { "const": true },
        "visualBaselineUpdatesRequireIndependentApproval": { "const": true },
        "qualitativeDimensions": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "minimumQualitativeScore": { "type": "number", "minimum": 0, "maximum": 5 },
        "releaseBlockerRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkpoint", "surface", "state", "themes", "viewports", "baselineRequired"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "checkpoint": { "type": "boolean" },
        "surface": { "enum": ["landing", "auth", "app", "tv", "legal", "white-label", "fixture"] },
        "state": { "type": "string", "minLength": 1 },
        "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
        "viewports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "baselineRequired": { "type": "boolean" },
        "expectedPath": { "type": "string", "pattern": "^/" },
        "env": { "type": "string" },
        "pattern": { "type": "string" }
      }
    }
  }
}
