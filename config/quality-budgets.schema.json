{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-quality-budgets-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "mode", "failOn", "allowedBaseUrls", "routes", "viewports", "budgets", "qualityPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "AxoBoard" },
    "mode": { "const": "public-non-mutating" },
    "failOn": {
      "type": "array",
      "items": { "enum": ["P0", "P1", "P2", "P3"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowedBaseUrls": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "optionalRoutes": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/route" },
          {
            "type": "object",
            "required": ["env", "pattern"],
            "properties": {
              "env": { "type": "string", "minLength": 1 },
              "pattern": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width", "height", "dpr"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 320 },
          "height": { "type": "integer", "minimum": 568 },
          "dpr": { "type": "number", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "canonicalScreenshotViewports": { "type": "array", "items": { "type": "string" } },
    "budgets": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 },
      "required": ["horizontalOverflowPx", "minimumTouchTargetPx", "lcpMs", "cls", "navigationMs"]
    },
    "sensitivePatterns": { "type": "array", "items": { "type": "string" } },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0P1BlockRelease", "maximumP2ForPremiumAcceptance", "expertReviewRequired", "visualBaselineUpdatesRequireIndependentApproval"],
      "properties": {
        "p0P1BlockRelease": { "const": true },
        "maximumP2ForPremiumAcceptance": { "type": "integer", "minimum": 0 },
        "expertReviewRequired": { "const": true },
        "visualBaselineUpdatesRequireIndependentApproval": { "const": true }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkpoint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "checkpoint": { "type": "boolean" },
        "surface": { "enum": ["public", "white-label"] },
        "env": { "type": "string" },
        "pattern": { "type": "string" }
      }
    }
  }
}

