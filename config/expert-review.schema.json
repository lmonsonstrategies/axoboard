{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoboard.io/schemas/apple-qa-expert-review-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidateSha", "targetOrigin", "captureActor", "reviewerId", "capturedAt", "reviewedAt", "reviews", "attestation"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "axoboard-expert-review-attestation" },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "targetOrigin": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "captureActor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "reviewerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "capturedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "reviewedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routeId", "state", "theme", "viewport", "browserEngine", "approved", "artifacts", "dimensions"],
        "properties": {
          "routeId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "state": { "type": "string", "minLength": 1, "maxLength": 100 },
          "theme": { "enum": ["light", "dark"] },
          "viewport": { "type": "string", "minLength": 1, "maxLength": 100 },
          "browserEngine": { "enum": ["chromium", "firefox", "webkit"] },
          "approved": { "const": true },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["screenshotSha256", "repeatScreenshotSha256"],
            "properties": {
              "screenshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "repeatScreenshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "dimensions": {
            "type": "array",
            "minItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "score", "evidence"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                "score": { "type": "number", "minimum": 0, "maximum": 5 },
                "evidence": { "type": "string", "minLength": 10, "maxLength": 4000 }
              }
            }
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payloadSha256", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,95}$" },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "minLength": 88, "maxLength": 88 }
      }
    }
  }
}
