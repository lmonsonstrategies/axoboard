# AxoBoard runtime (never commit real values)
DATABASE_URL=
DATABASE_SSL=true
APP_BASE_URL=https://axoboard.io

# Persistent TV displays. Falls back to AXOBOARD_OAUTH_ENCRYPTION_KEY when the
# dedicated secret is blank; use an independent 32+ character secret in production.
AXOBOARD_DISPLAY_RUNTIME_ENABLED=true
AXOBOARD_DISPLAY_BASE_URL=https://tv.axoboard.io
AXOBOARD_DISPLAY_TOKEN_SECRET=

# Direct Google OAuth — planned production connector
AXOBOARD_GOOGLE_CLIENT_ID=
AXOBOARD_GOOGLE_CLIENT_SECRET=
AXOBOARD_GOOGLE_REDIRECT_URI=https://axoboard.io/api/integrations/oauth/google/callback
AXOBOARD_OAUTH_ENCRYPTION_KEY=
AXOBOARD_SYNC_INTERVAL_MS=60000
AXOBOARD_ENGAGEMENT_CORE_ENABLED=true

# Versioned automation core and PostgreSQL-backed evaluator/delivery worker.
# Set either enabled flag to false for an immediate no-code rollback.
AXOBOARD_AUTOMATION_CORE_ENABLED=true
AXOBOARD_AUTOMATION_WORKER_ENABLED=true
AXOBOARD_AUTOMATION_WORKER_INTERVAL_MS=5000

# Stripe billing — configure sandbox values first; never commit real values
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
